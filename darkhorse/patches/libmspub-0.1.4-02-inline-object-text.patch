+// U+FFFC OBJECT REPLACEMENT CHARACTER in UTF-16LE
+bool isObjectReplacementAt(const std::vector<unsigned char> &chars, size_t i)
+{
+  return i + 1 < chars.size() && chars[i] == 0xFC && chars[i + 1] == 0xFF;
+}
+
+bool spanHasObjectReplacement(const TextSpan &span)
+{
+  for (size_t i = 0; i + 1 < span.chars.size(); i += 2)
+    if (isObjectReplacementAt(span.chars, i))
+      return true;
+  return false;
+}
+
+// True if the paragraph holds nothing but object replacement characters and whitespace
+bool paragraphIsOnlyObject(const TextParagraph &para)
+{
+  for (const auto &span : para.spans)
+  {
+    for (size_t i = 0; i + 1 < span.chars.size(); i += 2)
+    {
+      if (isObjectReplacementAt(span.chars, i))
+        continue;
+      const unsigned char c = span.chars[i];
+      const bool whitespace = span.chars[i + 1] == 0 && (c == ' ' || c == '\t' || c == '\r' || c == '\n' || c == 0x0b);
+      if (!whitespace)
+        return false;
+    }
+  }
+  return true;
+}
+
+void removeObjectReplacements(TextParagraph &para)
+{
+  for (auto &span : para.spans)
+  {
+    std::vector<unsigned char> kept;
+    for (size_t i = 0; i + 1 < span.chars.size(); i += 2)
+    {
+      if (!isObjectReplacementAt(span.chars, i))
+      {
+        kept.push_back(span.chars[i]);
+        kept.push_back(span.chars[i + 1]);
+      }
+    }
+    span.chars = kept;
+  }
+}
+
+}
+
+// Publisher keeps objects anchored inline in text (e.g. a text box holding a list) on an
+// internal dummy page, and marks their place in the text with U+FFFC. Those shapes are never
+// drawn, so their text was lost. Put each such story's paragraphs where its marker is,
+// pairing markers and inline stories in document order.
+void MSPUBCollector::spliceInlineObjectText()
+{
+  if (m_encodingHeuristic)
+    return; // only for Unicode (2002 and later) files
+
+  std::set<unsigned> placedTextIds;
+  std::vector<unsigned> inlineTextIds;
+  for (const auto &shape : m_shapeInfosBySeqNum)
+  {
+    const ShapeInfo &info = shape.second;
+    if (!bool(info.m_textId) || !bool(info.m_pageSeqNum))
+      continue;
+    if (m_pagesBySeqNum.find(info.m_pageSeqNum.get()) != m_pagesBySeqNum.end())
+      placedTextIds.insert(info.m_textId.get());
+  }
+  for (const auto &shape : m_shapeInfosBySeqNum)
+  {
+    const ShapeInfo &info = shape.second;
+    if (!bool(info.m_textId) || !bool(info.m_pageSeqNum))
+      continue;
+    const unsigned textId = info.m_textId.get();
+    if (m_pagesBySeqNum.find(info.m_pageSeqNum.get()) == m_pagesBySeqNum.end()
+        && placedTextIds.find(textId) == placedTextIds.end()
+        && m_textStringsById.find(textId) != m_textStringsById.end()
+        && std::find(inlineTextIds.begin(), inlineTextIds.end(), textId) == inlineTextIds.end())
+      inlineTextIds.push_back(textId);
+  }
+  if (inlineTextIds.empty())
+    return;
+
+  size_t next = 0;
+  for (auto &story : m_textStringsById)
+  {
+    if (next >= inlineTextIds.size())
+      break;
+    if (placedTextIds.find(story.first) == placedTextIds.end())
+      continue;
+    std::vector<TextParagraph> spliced;
+    for (const auto &para : story.second)
+    {
+      bool hasObject = false;
+      for (const auto &span : para.spans)
+        hasObject = hasObject || spanHasObjectReplacement(span);
+      if (!hasObject || next >= inlineTextIds.size())
+      {
+        spliced.push_back(para);
+        continue;
+      }
+      const std::vector<TextParagraph> &inlineText = m_textStringsById[inlineTextIds[next++]];
+      if (!paragraphIsOnlyObject(para))
+      {
+        TextParagraph rest = para;
+        removeObjectReplacements(rest);
+        spliced.push_back(rest);
+      }
+      spliced.insert(spliced.end(), inlineText.begin(), inlineText.end());
+    }
+    story.second = spliced;
+  }
+}
+
 bool MSPUBCollector::go()
 {
   addBlackToPaletteIfNecessary();
   assignShapesToPages();
+  spliceInlineObjectText();
   m_painter->startDocument(librevenge::RVNGPropertyList());
   m_painter->setDocumentMetaData(m_metaData);
 
